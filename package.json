{
  "name": "amrut-poultry-management",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import=./tests/harness/register.mjs \"tests/*.test.mjs\"",
    "test:run": "node --test --import=./tests/harness/register.mjs \"tests/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:unit": "node --test --import=./tests/harness/register.mjs \"tests/*.test.mjs\"",
    "test:integration": "node --test --import=./tests/harness/register.mjs \"tests/integration/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --import=./tests/harness/register.mjs \"tests/*.test.mjs\"",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "motion": "^13.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "three": "^0.186.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "pg": "^8.23.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.7"
  }
}
